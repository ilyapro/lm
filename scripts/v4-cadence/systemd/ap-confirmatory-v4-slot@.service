# Generated by scripts/v4_cadence.py.
# Edit that renderer and re-render; never edit this file.  Check a set with:
#     python3 -B scripts/v4_cadence.py verify --unit-dir <dir>
#
# Arming is an operator decision, and the first missed slot ends the campaign
# terminally.  Read docs/v4-campaign-runbook.md before installing anything.
[Unit]
Description=confirmatory-holdout-v4 accrual slot %i (one shot, then exit)
Documentation=file:///nonexistent/EXAMPLE-REPO-ROOT/docs/v4-campaign-runbook.md
# A manual start is an orchestration retry, and POLICY.md states that an
# orchestration retry is not a cadence event.  Only the timer may activate this.
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
# One slot per process: oneshot forks a fresh interpreter for each firing, and
# it is not held afterwards, so nothing survives into the next slot.
Type=oneshot
RemainAfterExit=no
Restart=no
# The whole slot must complete inside its grace window.
TimeoutStartSec=21600
WorkingDirectory=/nonexistent/EXAMPLE-REPO-ROOT
ExecStart=/usr/bin/python3 -B /nonexistent/EXAMPLE-REPO-ROOT/scripts/ap_confirmatory_slot_v4.py --work-dir /nonexistent/EXAMPLE-WORK-DIR --slot-index %i --campaign-module /nonexistent/EXAMPLE-PRIVATE/campaign.py
